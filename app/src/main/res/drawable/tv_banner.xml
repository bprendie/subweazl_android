<?xml version="1.0" encoding="utf-8"?>
<!-- A TV tile using the same original Subweazl artwork as the phone icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape><solid android:color="#000000"/><size android:width="320dp" android:height="180dp"/></shape>
    </item>
    <item android:width="120dp" android:height="120dp" android:gravity="left|center_vertical" android:left="8dp">
        <bitmap android:src="@drawable/launcher_art" android:gravity="fill" android:filter="true"/>
    </item>
    <item android:drawable="@drawable/tv_wordmark" android:width="174dp" android:height="96dp" android:gravity="right|center_vertical" android:right="10dp"/>
</layer-list>
